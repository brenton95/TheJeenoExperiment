# Ignore Python bytecode files
__pycache__/
*.py[cod]
*$py.class

# Ignore the Minigrid source tree if it's generated or vendored
Minigrid/

# Ignore editor and OS files
.vscode/
.DS_Store

# Ignore virtual environments
venv/
.venv/

# Ignore agent scratch / working files (plans, notes) — never enters a PR
.agent/

# Ignore Colab run logs / scratch output — never enters a PR
collab_logs/

# Ignore local-only live probes / scratch evals — never enters a PR
evals/probe_*.py
